---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchCatalogStats, fetchRadarStats } from '../lib/lab-stats.js';
import { listPublishedProjects } from '../lib/projects.js';

const catalogStats = await fetchCatalogStats();
const radarStats = await fetchRadarStats();
const progetti = listPublishedProjects();

/** One-liner editoriali per ecosistema — solo testo, l'elenco viene da projects/ */
const ecoDesc: Record<string, string> = {
  'open-siope': 'La spesa pubblica italiana — comuni, ASL, regioni, università',
  'open-conto-annuale': 'Il personale della PA — 3,4M dipendenti, €186 mld',
  'bilancio-pubblico': 'Entrate, uscite e saldo del bilancio statale 2003–2026',
  'eurostat': 'Dati regionali europei — PIL, popolazione, criminalità NUTS3',
  'dcl-bologna': 'Bologna in dati — ZTL, qualità dell\'aria, demografia',
  'rna-aiuti-stato': 'Ogni aiuto pubblico alle imprese — 17M+ record',
  'costituzione-italiana': '139 articoli, 21K sentenze, 16K citazioni — interrogabile',
  'open-politica': 'Elezioni dal 1948, Parlamento, governo — tutto interrogabile',
  'gu-monitor': 'La Gazzetta Ufficiale monitorata — 4.330 atti / 30gg',
  'italia-corpus': '20.716 atti normativi in Markdown, da Normattiva',
  'senato-akn': 'Il lavoro del Senato per peso documentale, non per numero',
  'debito-pubblico-intelligence': 'Intelligence sul debito — 165 anni, fusion layer, scenari',
  'partecipate-monitor': '121 partecipate pubbliche — profili incrociati da 6 fonti',
  'appalti-pubblici': 'Bandi, aggiudicazioni, imprese ANAC — 2016–2026',
  'open-consip': 'Acquisti centralizzati PA — 174K imprese dual-use',
  'open-pnrr': '194 mld PNRR — progetti, gare, pagamenti, indicatori',
  'open-coesione': '346 mld coesione — 128K progetti, 7,2M soggetti',
  'indice-pa': 'Anagrafe PA — 23K enti, 122K uffici, 53 categorie',
  'terzo-settore': '150K ETS — 8 fonti incrociate, matching bandi',
  'opere-pubbliche': '11,94M CUP — ANAC, PNRR, OpenCoesione incrociati',
  'opencivitas': 'FSC e indicatori — 6.600 comuni, 2015–2025',
  'patrimonio-territorio': '3,25M immobili pubblici — 100% georeferenziati',
  'giustizia-amministrativa': 'Contenzioso della Giustizia Amministrativa — 31 sedi, 2017–2026',
  'dichiarazioni-italia': 'IRPEF, IVA, IRES, IRAP — dichiarazioni fiscali MEF',
  'imprese-italia': 'Demografia d\'impresa — stock, flussi, Marche comunali',
  'open-inps': 'Lavoro, pensioni e welfare — 17 dataset INPS',
  'pil-intelligence': 'PIL e GVA province, debito 1861–2025, confronti OCPI',
  'sistema-bancario': 'Bilanci banche europee — EBA, BCE, World Bank',
  'energia-italia': 'Sistema elettrico — Terna e GME, mix, prezzi, emissioni',
  'open-ispra': 'Ambiente ISPRA — acque, suolo, pesticidi, frane',
  'open-mur': 'Università italiana — 92 atenei, MUR/USTAT',
  'rifiuti-urbani': 'Rifiuti urbani e speciali — Catasto ISPRA, comunale',
  'inpa-reclutamento': 'Bandi e concorsi PA — portale inPA, tempi e trasparenza',
  'open-noipa': 'Stipendi e dipendenti PA — NoiPA, 2019–2026',
  'italia-dipendenze': 'Dipendenze strategiche — gas, metalli, concentrazione fornitura',
  'progetto-pilota': 'Rifiuti urbani — primo proof of work del Lab (reference)',
};
---

<BaseLayout title="Ecosistema del Lab" description="I tre fronti pubblici di DataCivicLab: sito, dati, stato operativo">
  <p class="section-sub">
    DataCivicLab non è un solo posto. È un ecosistema di tre interfacce pubbliche,
    ognuna pensata per un bisogno diverso. Questa pagina ti orienta.
  </p>

  <h2>I tre fronti pubblici</h2>

  <div class="eco-grid">
    <div class="eco-card">
      <div class="eco-card-header">
        <span class="eco-icon">🏛️</span>
        <div>
          <h3>dataciviclab.org</h3>
          <span class="eco-tag">Vetrina del Lab</span>
        </div>
      </div>
      <p>Il sito che stai visitando. Qui trovi la spiegazione del progetto, i progetti del Lab,
      i documenti e come partecipare.</p>
      <ul class="eco-links">
        <li><a href={import.meta.env.BASE_URL + 'progetti/'}>Progetti</a></li>
        <li><a href={import.meta.env.BASE_URL + 'docs/'}>Documenti</a></li>
        <li><a href={import.meta.env.BASE_URL + 'chi-siamo/'}>Chi siamo</a></li>
      </ul>
      <p class="eco-tech"><strong>Stack:</strong> Astro · Statico · Build-time</p>
    </div>

    <div class="eco-card">
      <div class="eco-card-header">
        <span class="eco-icon">📚</span>
        <div>
          <h3>data-explorer</h3>
          <span class="eco-tag">Catalogo dataset</span>
        </div>
      </div>
      <p>Il frontend interattivo per esplorare i dataset puliti del Lab.
      Schede dataset, metadati, anteprime e query DuckDB dirette sui parquet pubblici.</p>
      <ul class="eco-links">
        <li><a href="https://dataciviclab.github.io/data-explorer/">Esplora il catalogo</a></li>
        <li><strong>{catalogStats.published}</strong> dataset pubblicati</li>
      </ul>
      <p class="eco-tech"><strong>Stack:</strong> Observable Framework · DuckDB · GCS</p>
    </div>

    <div class="eco-card">
      <div class="eco-card-header">
        <span class="eco-icon">📊</span>
        <div>
          <h3>lab-dashboard</h3>
          <span class="eco-tag">Dashboard operativa</span>
        </div>
      </div>
      <p>Metriche e stato in tempo reale: salute delle fonti, pipeline CI, funnel candidate,
      copertura dati, discussioni recenti. Per chi lavora nel Lab.</p>
      <ul class="eco-links">
        <li><a href="https://dataciviclab-dashboard.streamlit.app/">Apri la dashboard</a></li>
        <li><strong>{radarStats.total}</strong> fonti monitorate · {radarStats.green} 🟢 {radarStats.yellow} 🟡 {radarStats.red} 🔴</li>
      </ul>
      <p class="eco-tech"><strong>Stack:</strong> Streamlit · DuckDB · Altair · GitHub API</p>
    </div>
  </div>

  <h2>Repository</h2>
  <p>Tutto il codice del Lab è su GitHub. Ogni repo ha un ruolo preciso.</p>

  <h3 class="eco-section-title">Infrastruttura</h3>
  <div class="eco-repo-grid">
    <div class="eco-repo-row">
      <span class="eco-repo-name"><a href="https://github.com/dataciviclab/dataciviclab">dataciviclab</a></span>
      <span class="eco-repo-desc">Hub pubblico: sito, progetti, documenti, discussioni</span>
    </div>
    <div class="eco-repo-row">
      <span class="eco-repo-name"><a href="https://github.com/dataciviclab/source-observatory">source-observatory</a></span>
      <span class="eco-repo-desc">Scouting e monitoraggio delle fonti pubbliche</span>
    </div>
    <div class="eco-repo-row">
      <span class="eco-repo-name"><a href="https://github.com/dataciviclab/dataset-incubator">dataset-incubator</a></span>
      <span class="eco-repo-desc">Intake tecnico: candidate, pipeline, contratto dati</span>
    </div>
    <div class="eco-repo-row">
      <span class="eco-repo-name"><a href="https://github.com/dataciviclab/toolkit">toolkit</a></span>
      <span class="eco-repo-desc">Motore RAW → CLEAN → MART</span>
    </div>
    <div class="eco-repo-row">
      <span class="eco-repo-name"><a href="https://github.com/dataciviclab/data-explorer">data-explorer</a></span>
      <span class="eco-repo-desc">Frontend pubblico del catalogo dataset</span>
    </div>
    <div class="eco-repo-row">
      <span class="eco-repo-name"><a href="https://github.com/dataciviclab/lab-connectors">lab-connectors</a></span>
      <span class="eco-repo-desc">Libreria condivisa: HTTP, GCS, DuckDB</span>
    </div>
    <div class="eco-repo-row">
      <span class="eco-repo-name"><a href="https://github.com/dataciviclab/lab-dashboard">lab-dashboard</a></span>
      <span class="eco-repo-desc">Dashboard operativa Streamlit</span>
    </div>
  </div>

  <h3 class="eco-section-title">Progetti <span class="eco-count">{progetti.length}</span></h3>
  <div class="eco-repo-grid">
    {progetti.map((p) => (
      <div class="eco-repo-row">
        <span class="eco-repo-name"><a href={`https://github.com/${p.repo}`}>{p.slug}</a></span>
        <span class="eco-repo-desc">{ecoDesc[p.slug] ?? p.title}</span>
      </div>
    ))}
  </div>

  <h2>Il funnel</h2>
  <p>Dal momento in cui arriva una domanda civica al momento in cui i dati sono pubblici:</p>
  <div class="eco-funnel">
    <span class="funnel-step">Domanda</span>
    <span class="funnel-arrow">→</span>
    <span class="funnel-step">Scouting</span>
    <span class="funnel-arrow">→</span>
    <span class="funnel-step">Incubazione</span>
    <span class="funnel-arrow">→</span>
    <span class="funnel-step">Esplorazione</span>
  </div>

  <h2>Come partecipare</h2>
  <p>Non serve saper programmare.</p>
  <ul>
    <li><strong>Hai una domanda sui dati pubblici?</strong> — Apri una <a href="https://github.com/orgs/dataciviclab/discussions/new?category=Domanda">Discussion</a></li>
    <li><strong>Hai trovato una fonte interessante?</strong> — Segnalala in una Discussion o passa su <a href="https://github.com/dataciviclab/source-observatory">source-observatory</a></li>
    <li><strong>Vuoi scrivere pipeline?</strong> — Dai un'occhiata ai <a href="https://github.com/dataciviclab/dataset-incubator/labels/good%20first+issue">good first issue in dataset-incubator</a></li>
    <li><strong>Vuoi solo seguire il lavoro?</strong> — Unisciti al <a href="https://discord.gg/rAHpuTrYK3">Discord</a> o segui <a href="https://www.linkedin.com/company/dataciviclab/">LinkedIn</a></li>
  </ul>
</BaseLayout>

<style>
  .eco-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  .eco-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .eco-card-header {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .eco-card-header h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .eco-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .eco-tag {
    display: inline-block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-light);
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
  }

  .eco-links {
    list-style: none;
    margin: 0.75rem 0;
    padding: 0;
    font-size: 0.9rem;
  }

  .eco-links li {
    margin-bottom: 0.3rem;
  }

  .eco-tech {
    font-size: 0.8rem;
    color: var(--text-tertiary);
    margin: 0.5rem 0 0;
  }

  .eco-section-title {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .eco-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    background: var(--accent-light);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .eco-repo-grid {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0.75rem 0 1.5rem;
  }

  .eco-repo-row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.5rem 0.75rem;
    background: var(--bg-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    transition: border-color 0.15s;
  }

  .eco-repo-row:hover {
    border-color: var(--accent);
  }

  .eco-repo-name {
    font-weight: 600;
    white-space: nowrap;
    min-width: 180px;
  }

  .eco-repo-name a {
    color: var(--accent);
    text-decoration: none;
  }

  .eco-repo-name a:hover {
    text-decoration: underline;
  }

  .eco-repo-desc {
    color: var(--text-secondary);
  }

  .eco-funnel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 1rem 0 1.5rem;
    padding: 1rem;
    background: var(--bg-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .funnel-step {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--accent);
    padding: 0.25rem 0.6rem;
    background: var(--accent-light);
    border-radius: var(--radius-sm);
  }

  .funnel-arrow {
    color: var(--text-tertiary);
    font-size: 1.1rem;
  }

  @media (max-width: 700px) {
    .eco-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
