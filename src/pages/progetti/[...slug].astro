---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatsCallout from '../../components/StatsCallout.astro';

export async function getStaticPaths() {
  const modules = import.meta.glob('/projects/*.md', { eager: true });
  return Object.entries(modules)
    .filter(([filepath]) => !filepath.endsWith('/README.md'))
    .map(([filepath, mod]: [string, any]) => {
      const parts = filepath.split('/');
      const filename = parts[parts.length - 1] ?? '';
      const slug = filename.replace(/\.md$/, '');
      return {
        params: { slug },
        props: { mod },
      };
    });
}

const { mod } = Astro.props;
const parts = mod?.file?.split('/') ?? [];
const filename = parts[parts.length - 1] ?? '';
const slug = filename.replace(/\.md$/, '');
const fm = mod?.frontmatter ?? {};
const title = fm.title || slug;
const description = fm.description || `Progetto: ${title}`;
const Content = mod?.Content;
const repo = fm.repo || null;
const topics = fm.topics || [];
const datasetSlug = fm.dataset_slug || null;
const stats = fm.stats || [];
const explorerUrl = datasetSlug
  ? `https://dataciviclab.github.io/data-explorer/`
  : null;
---

<BaseLayout title={title} description={description}>
  {Content ? (
    <article>
      <div class="progetto-hero">
        <div class="progetto-tags">
          {topics.map((t: string) => (
            <span class={`topic-badge topic-${t}`}>{t}</span>
          ))}
        </div>
        <div class="progetto-links">
          {repo && (
            <a href={`https://github.com/${repo}`} class="btn btn-secondary">
              GitHub →
            </a>
          )}
          {explorerUrl && (
            <a href={explorerUrl} class="btn btn-primary">
              Su Explorer
            </a>
          )}
        </div>
      </div>

      <StatsCallout stats={stats} />

      <div class="progetto-content">
        <Content />
      </div>
    </article>
  ) : (
    <p>Contenuto non disponibile.</p>
  )}
</BaseLayout>

<style>
  .progetto-hero {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .progetto-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .topic-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
    color: #fff;
    background: #64748b;
  }

  .topic-economia, .topic-fisco { background: #065f46; }
  .topic-pubblica-amministrazione { background: #6d28d9; }
  .topic-giustizia { background: #b91c1c; }
  .topic-sanita { background: #0e7490; }
  .topic-energia { background: #d97706; }
  .topic-ambiente { background: #15803d; }
  .topic-enti-locali { background: #4338ca; }
  .topic-finanza-pubblica { background: #065f46; }
  .topic-trasparenza { background: #6d28d9; }
  .topic-territorio { background: #15803d; }
  .topic-lavoro { background: #0e7490; }
  .topic-mobilita { background: #4338ca; }
  .topic-democrazia { background: #b91c1c; }
  .topic-demografia { background: #0e7490; }
  .topic-bilancio { background: #065f46; }
  .topic-fondi-europei { background: #d97706; }
  .topic-acquisti-pubblici { background: #6d28d9; }
  .topic-pnrr { background: #d97706; }
  .topic-infrastrutture { background: #4338ca; }
  .topic-patrimonio-pubblico { background: #15803d; }
  .topic-sociale { background: #0e7490; }
  .topic-terzo-settore { background: #0e7490; }

  .progetto-links {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .progetto-content {
    margin-top: 1.5rem;
  }
</style>
