---
import BaseLayout from '../../layouts/BaseLayout.astro';

const projectModules = import.meta.glob('/projects/*.md', { eager: true });

interface ProgettoMeta {
  slug: string;
  title: string;
  excerpt: string;
  topics: string[];
  status: string;
  repo: string | null;
}

const progettiList: ProgettoMeta[] = Object.entries(projectModules)
  .filter(([filepath]) => !filepath.endsWith('/README.md'))
  .map(([filepath, mod]: [string, any]) => {
    const parts = filepath.split('/');
    const filename = parts[parts.length - 1] ?? '';
    const slug = filename.replace(/\.md$/, '');
    const fm = mod.frontmatter ?? {};
    return {
      slug,
      title: fm.title || slug,
      excerpt: fm.description || '',
      topics: fm.topics || [],
      status: fm.status || 'active',
      repo: fm.repo || null,
    };
  })
  .sort((a, b) => {
    // featured first, then by slug
    const aMod = projectModules[`/projects/${a.slug}.md`] as any;
    const bMod = projectModules[`/projects/${b.slug}.md`] as any;
    const aFeatured = aMod?.frontmatter?.featured ?? false;
    const bFeatured = bMod?.frontmatter?.featured ?? false;
    if (aFeatured && !bFeatured) return -1;
    if (!aFeatured && bFeatured) return 1;
    return a.slug.localeCompare(b.slug);
  });
---

<BaseLayout title="Progetti" description="I progetti pubblici del DataCivicLab">
  <p class="section-sub">
    Ogni progetto parte da una domanda civica e produce dati aperti, analisi e strumenti pubblici.
    Alcuni sono attivi, altri sono reference — tutto il codice è su GitHub.
  </p>

  {progettiList.length === 0 && <p><em>Nessun progetto ancora pubblicato.</em></p>}

  {progettiList.map((entry) => (
    <div class="card">
      <h2><a href={`${import.meta.env.BASE_URL}progetti/${entry.slug}/`}>{entry.title}</a></h2>
      {entry.excerpt && <p>{entry.excerpt}</p>}
      <div class="progetto-meta">
        {entry.topics.length > 0
          ? entry.topics.map((topic) => (
              <span class={`topic-badge topic-${topic}`}>
                {topic}
              </span>
            ))
          : <span class="topic-badge muted">generale</span>
        }
        <span class={`topic-badge status-${entry.status}`}>
          {entry.status}
        </span>
        {entry.repo && (
          <a href={`https://github.com/${entry.repo}`} class="repo-badge">
            GitHub →
          </a>
        )}
      </div>
    </div>
  ))}
</BaseLayout>

<style>
  .progetto-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .topic-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
    color: #fff;
    background: #64748b;
  }

  .topic-badge.muted {
    background: var(--bg-muted);
    color: var(--text-tertiary);
    border: 1px solid var(--border);
  }

  .topic-economia,
  .topic-fisco { background: #065f46; }

  .topic-pubblica-amministrazione { background: #6d28d9; }
  .topic-giustizia { background: #b91c1c; }
  .topic-sanita { background: #0e7490; }
  .topic-energia { background: #d97706; }
  .topic-ambiente { background: #15803d; }
  .topic-enti-locali { background: #4338ca; }
  .topic-finanza-pubblica { background: #065f46; }
  .topic-trasparenza { background: #6d28d9; }
  .topic-territorio { background: #15803d; }
  .topic-lavoro { background: #0e7490; }

  .status-active { background: #16a34a; }
  .status-reference { background: #64748b; }
  .status-review { background: #d97706; }

  .repo-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    background: var(--bg-muted);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    text-decoration: none;
    transition: all 0.15s;
  }

  .repo-badge:hover {
    background: var(--border);
    color: var(--text);
    text-decoration: none;
  }
</style>
